# Copy to .env.local for local dev. In production set these in Cloudflare (wrangler secrets / dashboard).
# Never commit real values.

# Supabase (local: `supabase status`; hosted: Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for invites, file uploads and signed URLs after an authorization check.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used in invite / password-reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show the "Sign in with Google" button (configure the Google provider in Supabase first)
NEXT_PUBLIC_GOOGLE_SIGN_IN=false
